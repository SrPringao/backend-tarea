{
  "name": "backend-tarea",
  "version": "2.0.0",
  "description": "API de finanzas personales (gastos, presupuestos y patrimonio) para cliente Flutter. Express + PostgreSQL (local o Supabase) con REST (Sequelize y SQL nativo), GraphQL y servicio de correo.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:up": "docker compose up -d",
    "db:init": "node scripts/db-init.js",
    "db:init:test": "cross-env NODE_ENV=test node scripts/db-init.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:report": "cross-env NODE_ENV=test jest --runInBand --json --outputFile=docs/resultados-pruebas.json",
    "docs:excel": "node scripts/generar-excel.js",
    "docs:postman": "node scripts/generar-postman.js",
    "docs:graphql": "node scripts/generar-docs-graphql.js",
    "docs:all": "npm run test:report; npm run docs:excel && npm run docs:postman && npm run docs:graphql",
    "zip": "node scripts/empaquetar.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@escape.tech/graphql-armor": "^3.2.0",
    "@graphql-yoga/plugin-disable-introspection": "^2.25.6",
    "@supabase/storage-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "spectaql": "^3.0.9",
    "supertest": "^7.1.0"
  }
}
