{
  "name": "backend-tarea",
  "version": "1.0.0",
  "description": "API REST de finanzas personales (gastos, presupuestos y patrimonio) para cliente Flutter. Express + PostgreSQL con Sequelize y SQL nativo.",
  "main": "src/server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:up": "docker compose up -d",
    "db:init": "node scripts/db-init.js",
    "db:init:test": "NODE_ENV=test node scripts/db-init.js",
    "test": "NODE_ENV=test jest --runInBand",
    "test:report": "NODE_ENV=test jest --runInBand --json --outputFile=docs/resultados-pruebas.json",
    "docs:excel": "node scripts/generar-excel.js",
    "docs:postman": "node scripts/generar-postman.js",
    "docs:all": "npm run test:report; npm run docs:excel && npm run docs:postman",
    "zip": "cd .. && rm -f backend-tarea.zip && zip -rq backend-tarea.zip backend-tarea -x 'backend-tarea/node_modules/*' 'backend-tarea/.env' '*.DS_Store' '*/~$*' && echo 'Generado ../backend-tarea.zip'"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "joi": "^17.13.3",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "exceljs": "^4.4.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.1.0"
  }
}
