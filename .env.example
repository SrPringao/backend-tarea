# =====================================================================
# Configuración de la API. Copia este archivo como .env (o ejecuta "npm run setup", que lo crea solo).
# .env NUNCA se sube al repositorio ni al zip: contiene credenciales.
# =====================================================================

NODE_ENV=development
PORT=3000
# URL pública de la API; se usa en los enlaces de los correos (confirmación de cuenta)
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Base de datos: elige UNA de las dos opciones
# ---------------------------------------------------------------------
# Opción A) PostgreSQL local (tu propio servidor). "npm run setup" crea la base si no existe.
#   Con el docker-compose del proyecto usa: DB_PORT=5434, DB_USER=tarea, DB_PASSWORD=tarea_dev
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
# Contraseña de tu usuario de PostgreSQL
DB_PASSWORD=
DB_NAME=gastos_tarea
DB_NAME_TEST=gastos_tarea_test
DB_LOGGING=false

# Opción B) Supabase u otro PostgreSQL en la nube: cadena "Session pooler" (puerto 5432).
#   Si la contraseña tiene símbolos (@ # / ?), codifícalos en la URL (p. ej. @ = %40).
#   Si DATABASE_URL está definida, se usa en lugar de las variables DB_*. Las pruebas siempre usan DB_NAME_TEST.
# DATABASE_URL=postgresql://postgres.<ref>:<contraseña>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DB_SSL=true

# ---------------------------------------------------------------------
# Seguridad
# ---------------------------------------------------------------------
# Secreto para firmar los JWT. Déjalo vacío: "npm run setup" genera uno aleatorio al crear .env.
# Si lo escribes a mano, usa un valor largo y aleatorio (mínimo 32 caracteres); nunca uno de ejemplo.
JWT_SECRET=
JWT_EXPIRES_IN=8h
REFRESH_TOKEN_DAYS=30
# Orígenes permitidos separados por coma. "*" para desarrollo (la app móvil de Flutter no envía Origin).
# En producción la API debe servirse por HTTPS (detrás de un proxy como Nginx o la plataforma de hosting).
CORS_ORIGINS=*

# ---------------------------------------------------------------------
# Correo (opcional). Sin estas variables los correos se muestran en la consola y la API funciona igual.
# Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" (16 caracteres).
# ---------------------------------------------------------------------
GMAIL_USER=
GMAIL_APP_PASSWORD=
# MAIL_FROM="Finanzas Personales" <tu_correo@gmail.com>

# ---------------------------------------------------------------------
# Archivos (opcional). Sin Supabase, la imagen de la tarjeta y los comprobantes se guardan en uploads/.
# Usa la "secret key" (sb_secret_...) o la service_role: solo en el backend, nunca en la app.
# ---------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=archivos

# ---------------------------------------------------------------------
# Tareas programadas (opcional): alertas de presupuesto, recordatorios y resumen diario a las 08:00
# ---------------------------------------------------------------------
ENABLE_SCHEDULER=false
SCHEDULER_TZ=America/Mexico_City
