{
  "info": {
    "name": "API Finanzas Personales",
    "description": "Colección generada desde el inventario de operaciones. Ejecuta primero \"Autenticación > POST Iniciar sesión\" (usuario demo) y el token se guarda solo. Para probar las rutas de administración inicia sesión con admin@gastos.app / Admin1234.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "POST Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Crea la cuenta (contraseña con bcrypt) y sus preferencias en una transacción; devuelve un JWT.\n\nAcceso a datos: Sequelize ORM | Seguridad: Pública",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana@correo.com\",\n  \"password\": \"Secreta123\",\n  \"displayName\": \"Ana López\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde con token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Valida credenciales y devuelve un JWT con vigencia configurable.\n\nAcceso a datos: Sequelize ORM | Seguridad: Pública",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@gastos.app\",\n  \"password\": \"Demo1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('Responde con token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "if (body.data && body.data.token) pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        },
        {
